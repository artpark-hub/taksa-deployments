export KRATOS_PG_DB=${KRATOS_PG_DB:-$POSTGRES_DB}
export KRATOS_PG_PORT=${KRATOS_PG_PORT:-$POSTGRES_PORT}
export KRATOS_DSN="postgres://${KRATOS_PG_USER}:${KRATOS_PG_PASSWORD}@taksa-ory-db:${KRATOS_PG_PORT}/${KRATOS_PG_DB}?sslmode=disable&max_conns=20&max_idle_conns=4"

export TSDB_PG_USER=${TSDB_PG_USER:-$POSTGRES_USER}
