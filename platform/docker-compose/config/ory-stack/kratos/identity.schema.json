{
  "$id": "https://schemas.ory.sh/presets/kratos/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "object",
          "properties": {
            "first": {
              "type": "string",
              "title": "First Name"
            },
            "last": {
              "type": "string",
              "title": "Last Name"
            }
          }
        },
        "role": {
          "type": "string",
          "enum": [
            "master",
            "admin",
            "member",
            "sub"
          ],
          "title": "User Role",
          "description": "Role of the user within the organization",
          "default": "sub"
        },
        "organization_name": {
          "type": "string",
          "title": "Organization Name",
          "description": "The organization this user belongs to",
          "minLength": 1
        }
      },
      "required": [
        "email",
        "organization_name"
      ],
      "additionalProperties": false
    }
  }
}