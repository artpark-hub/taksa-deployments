[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req

[dn]
C = IN
ST = Karnataka
L = Bengaluru
O = Taksa Factory
OU = Manufacturing
CN = localcontroller.taksa-factory.manufacturing

[v3_req]
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = localcontroller.taksa-factory.manufacturing
DNS.2 = *.localcontroller.taksa-factory.manufacturing
DNS.3 = localhost
DNS.4 = *.taksa-factory.manufacturing
IP.1 = 127.0.0.1
